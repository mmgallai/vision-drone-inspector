<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="recon_world">

    <!-- ── GUI camera — south view looking north
         Room is now 20×16 m (walls at x=±10, y=±8). Camera pulled back
         to (1, -16, 9) so the whole room fits in the default view.
         yaw=π/2 faces +Y (north). pitch=0.55 looks down ~31°.
    ─────────────────────────────────────────────────────────────────────── -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>1 -16 9 0 0.55 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ── Plugins ─────────────────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>

    <!-- ── Lighting ───────────────────────────────────────────────────── -->
    <scene>
      <!-- Lower ambient + warmer background gives more visible shading
           and contrast on the new props (plant leaves, mailbox flap, etc.).
           The previous 0.55 ambient washed everything to roughly the same
           brightness regardless of the directional sun. -->
      <ambient>0.38 0.38 0.40 1</ambient>
      <background>0.22 0.24 0.28 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0.3 0.5</pose>
      <!-- Diffuse + specular components must each be in [0,1]. We get
           the "stronger sun" effect by pairing max-strength diffuse
           with a higher specular bump than the original. -->
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.45 0.42 0.38 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <light type="point" name="fill_left">
      <pose>-4 0 3.0 0 0 0</pose>
      <diffuse>0.4 0.45 0.5 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <attenuation><range>12</range><linear>0.1</linear></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="fill_right">
      <pose>5 0 3.0 0 0 0</pose>
      <diffuse>0.4 0.42 0.45 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <attenuation><range>12</range><linear>0.1</linear></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ── Concrete floor ─────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.32 0.30 0.28 1</ambient>
            <diffuse>0.42 0.40 0.37 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         ROOM WALLS
         Inner dimensions: 14 m (X: -7 to +7) × 10 m (Y: -5 to +5)
         Drone max altitude: 2.5 m  →  wall height: 3.5 m
         ════════════════════════════════════════════════════════════════ -->

    <!-- East wall (drone side, x = +10) -->
    <model name="wall_east">
      <static>true</static>
      <pose>10.15 0 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.30 16.60 3.50</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.30 16.60 3.50</size></box></geometry>
          <material>
            <ambient>0.52 0.50 0.47 1</ambient>
            <diffuse>0.65 0.62 0.57 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall (target side, x = -10) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-10.15 0 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.30 16.60 3.50</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.30 16.60 3.50</size></box></geometry>
          <material>
            <ambient>0.52 0.50 0.47 1</ambient>
            <diffuse>0.65 0.62 0.57 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- North wall (y = +8) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 8.15 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.60 0.30 3.50</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20.60 0.30 3.50</size></box></geometry>
          <material>
            <ambient>0.52 0.50 0.47 1</ambient>
            <diffuse>0.65 0.62 0.57 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall (y = -8) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -8.15 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.60 0.30 3.50</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20.60 0.30 3.50</size></box></geometry>
          <material>
            <ambient>0.52 0.50 0.47 1</ambient>
            <diffuse>0.65 0.62 0.57 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- (Internal barrier removed: drone flies straight from takeoff
         to objects through open space.) -->

    <!-- ════════════════════════════════════════════════════════════════
         TARGET: Fire Hydrant  (world origin — mission_node orbits here)
         ════════════════════════════════════════════════════════════════ -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Fire Hydrant</uri>
      <name>target</name>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- ════════════════════════════════════════════════════════════════
         DISTRACTING OBJECTS — TARGET SIDE  (x < 3)
         ════════════════════════════════════════════════════════════════ -->

    <!-- Construction cone — target side north -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_target_n</name>
      <pose>-3.5 3.2 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Construction cone — target side south -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_target_s</name>
      <pose>-2.0 -3.5 0 0 0 0.8</pose>
      <static>true</static>
    </include>

    <!-- Steel drum / barrel (SDF cylinder) — target side -->
    <model name="barrel_target">
      <static>true</static>
      <pose>1.5 3.5 0.44 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.28</radius><length>0.88</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.28</radius><length>0.88</length></cylinder></geometry>
          <material>
            <ambient>0.10 0.25 0.10 1</ambient>
            <diffuse>0.15 0.35 0.15 1</diffuse>
            <specular>0.15 0.20 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wooden crate — against west wall -->
    <model name="crate_target">
      <static>true</static>
      <pose>-5.5 -2.5 0.30 0 0 0.3</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.60 0.60 0.60</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.60 0.60 0.60</size></box></geometry>
          <material>
            <ambient>0.42 0.28 0.14 1</ambient>
            <diffuse>0.52 0.36 0.20 1</diffuse>
            <specular>0.04 0.03 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         SCENE PROPS — realistic Fuel meshes for mailbox / trash bin /
         bench, plus a tall improved primitive potted plant. Each object
         is placed so its per-target orbit ring (radius from targets.py)
         stays inside the room, clear of the barrier wall (x=3.0,
         y∈[-3,3]), and clear of the corridor (y=4.2). Pairwise
         distances are wide enough that every object can be SAM3-
         disambiguated even at the search altitude (2.5 m).
         ════════════════════════════════════════════════════════════════ -->

    <!-- ── Potted plant: tall ficus-style primitive at NW (-3.5, 1.5) ─
         Built from primitives because no Fuel model has both a pot AND
         visible foliage. Sized like a real indoor tree (~1.2 m tall) so
         SAM3 segments it at search altitude. Foliage is a dense cluster
         of varied-green spheres + flat leaf boxes radiating outward. -->
    <model name="potted_plant">
      <static>true</static>
      <pose>-3.5 1.5 0 0 0 0</pose>
      <link name="link">
        <!-- Terracotta pot -->
        <collision name="col_pot">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.36</length></cylinder></geometry>
        </collision>
        <visual name="vis_pot">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.36</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.28 0.16 1</ambient>
            <diffuse>0.78 0.42 0.24 1</diffuse>
            <specular>0.06 0.03 0.02 1</specular>
          </material>
        </visual>
        <!-- Soil disc -->
        <visual name="vis_soil">
          <pose>0 0 0.365 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.18 0.10 0.05 1</ambient>
            <diffuse>0.22 0.13 0.06 1</diffuse>
          </material>
        </visual>
        <!-- Trunk -->
        <visual name="vis_trunk">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.030</radius><length>0.55</length></cylinder></geometry>
          <material>
            <ambient>0.30 0.18 0.08 1</ambient>
            <diffuse>0.40 0.25 0.12 1</diffuse>
          </material>
        </visual>
        <!-- Foliage: large central canopy + 6 outer leaf clusters -->
        <visual name="vis_canopy">
          <pose>0 0 1.05 0 0 0</pose>
          <geometry><sphere><radius>0.32</radius></sphere></geometry>
          <material>
            <ambient>0.08 0.30 0.10 1</ambient>
            <diffuse>0.18 0.55 0.20 1</diffuse>
            <specular>0.05 0.10 0.05 1</specular>
          </material>
        </visual>
        <visual name="vis_leaf_n">
          <pose>0.20 0.00 1.00 0 0 0</pose>
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.10 0.34 0.12 1</ambient><diffuse>0.22 0.62 0.24 1</diffuse></material>
        </visual>
        <visual name="vis_leaf_s">
          <pose>-0.20 0.00 1.00 0 0 0</pose>
          <geometry><sphere><radius>0.17</radius></sphere></geometry>
          <material><ambient>0.06 0.28 0.10 1</ambient><diffuse>0.14 0.52 0.18 1</diffuse></material>
        </visual>
        <visual name="vis_leaf_e">
          <pose>0.00 0.20 1.02 0 0 0</pose>
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.10 0.36 0.10 1</ambient><diffuse>0.20 0.60 0.22 1</diffuse></material>
        </visual>
        <visual name="vis_leaf_w">
          <pose>0.00 -0.20 1.02 0 0 0</pose>
          <geometry><sphere><radius>0.17</radius></sphere></geometry>
          <material><ambient>0.08 0.32 0.10 1</ambient><diffuse>0.18 0.55 0.18 1</diffuse></material>
        </visual>
        <visual name="vis_leaf_top">
          <pose>0.00 0.00 1.30 0 0 0</pose>
          <geometry><sphere><radius>0.16</radius></sphere></geometry>
          <material><ambient>0.12 0.38 0.14 1</ambient><diffuse>0.24 0.66 0.26 1</diffuse></material>
        </visual>
        <visual name="vis_leaf_bot">
          <pose>0.00 0.00 0.85 0 0 0</pose>
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.06 0.26 0.08 1</ambient><diffuse>0.14 0.48 0.16 1</diffuse></material>
        </visual>
        <!-- Outer leaf "blades" — flat boxes for silhouette detail -->
        <visual name="vis_blade_1">
          <pose> 0.32  0.00 1.05 0 0.4 0</pose>
          <geometry><box><size>0.18 0.05 0.01</size></box></geometry>
          <material><ambient>0.10 0.36 0.10 1</ambient><diffuse>0.22 0.62 0.22 1</diffuse></material>
        </visual>
        <visual name="vis_blade_2">
          <pose> 0.00  0.32 1.10 0 0.4 1.5708</pose>
          <geometry><box><size>0.18 0.05 0.01</size></box></geometry>
          <material><ambient>0.08 0.32 0.10 1</ambient><diffuse>0.18 0.55 0.18 1</diffuse></material>
        </visual>
        <visual name="vis_blade_3">
          <pose>-0.30  0.00 1.00 0 -0.4 0</pose>
          <geometry><box><size>0.18 0.05 0.01</size></box></geometry>
          <material><ambient>0.10 0.34 0.12 1</ambient><diffuse>0.22 0.60 0.24 1</diffuse></material>
        </visual>
        <visual name="vis_blade_4">
          <pose> 0.00 -0.30 1.05 0 -0.4 1.5708</pose>
          <geometry><box><size>0.18 0.05 0.01</size></box></geometry>
          <material><ambient>0.08 0.30 0.10 1</ambient><diffuse>0.18 0.52 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Park bench (primitive — wooden slats + black metal frame) ──
         The Fuel AirportBench was shaped like an unfamiliar lounger
         that SAM3 didn't classify under any prompt. This primitive is
         a canonical 3-slat wooden park bench: long brown seat + back-
         rest on stout black legs, the silhouette ImageNet/COCO label
         "bench" was trained on. -->
    <model name="park_bench">
      <static>true</static>
      <pose>-3.5 -1.5 0 0 0 0</pose>
      <link name="link">
        <!-- Seat (long brown slab, ~1.6 m) -->
        <collision name="col_seat">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.60 0.40 0.06</size></box></geometry>
        </collision>
        <visual name="vis_seat">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.60 0.40 0.06</size></box></geometry>
          <material>
            <ambient>0.30 0.18 0.10 1</ambient>
            <diffuse>0.55 0.34 0.18 1</diffuse>
            <specular>0.05 0.03 0.02 1</specular>
          </material>
        </visual>
        <!-- Backrest (vertical brown panel) -->
        <visual name="vis_back">
          <pose>0 -0.18 0.75 0 0 0</pose>
          <geometry><box><size>1.60 0.05 0.45</size></box></geometry>
          <material>
            <ambient>0.30 0.18 0.10 1</ambient>
            <diffuse>0.55 0.34 0.18 1</diffuse>
          </material>
        </visual>
        <!-- 4 black metal legs -->
        <visual name="vis_leg_lf">
          <pose>-0.72 0.16 0.225 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.45</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse></material>
        </visual>
        <visual name="vis_leg_rf">
          <pose> 0.72 0.16 0.225 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.45</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse></material>
        </visual>
        <visual name="vis_leg_lb">
          <pose>-0.72 -0.16 0.225 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.45</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse></material>
        </visual>
        <visual name="vis_leg_rb">
          <pose> 0.72 -0.16 0.225 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.45</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse></material>
        </visual>
        <!-- Backrest support uprights -->
        <visual name="vis_back_lup">
          <pose>-0.72 -0.18 0.65 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.50</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse></material>
        </visual>
        <visual name="vis_back_rup">
          <pose> 0.72 -0.18 0.65 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.50</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Trash bin (primitive — gray cylinder + lid + opening) ──
         The Fuel TrashBin (small portable) didn't trigger any of
         "trash bin", "trash can", "garbage can", "dumpster". This
         primitive is the iconic gray outdoor trash can: ~0.55 m
         radius, ~1 m tall, dark gray body, slightly wider lid with
         a visible opening. -->
    <model name="trash_bin">
      <static>true</static>
      <pose>1.5 -2.0 0 0 0 0</pose>
      <link name="link">
        <!-- Body -->
        <collision name="col_body">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>1.00</length></cylinder></geometry>
        </collision>
        <visual name="vis_body">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>1.00</length></cylinder></geometry>
          <material>
            <ambient>0.20 0.20 0.22 1</ambient>
            <diffuse>0.35 0.35 0.40 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
        <!-- Slightly wider lid -->
        <visual name="vis_lid">
          <pose>0 0 1.04 0 0 0</pose>
          <geometry><cylinder><radius>0.33</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.10 0.10 0.12 1</ambient>
            <diffuse>0.20 0.20 0.22 1</diffuse>
          </material>
        </visual>
        <!-- Dark opening cutout (visual cue) -->
        <visual name="vis_opening">
          <pose>0 0.18 1.07 0 0 0</pose>
          <geometry><box><size>0.20 0.05 0.04</size></box></geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.04 0.04 0.04 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Mailbox (primitive — USPS-style curved-top box on post) ──
         The Fuel Mailbox model rendered as an unfamiliar green tube
         on a post that SAM3 saw as garbage. This is the canonical
         American USPS curbside mailbox: dark blue rectangular body
         with rounded top, mounted on a wooden post, small red flag.
         That's a very iconic shape with strong COCO/ImageNet support. -->
    <model name="mailbox">
      <static>true</static>
      <pose>1.5 2.0 0 0 0 0</pose>
      <link name="link">
        <!-- Wooden post -->
        <collision name="col_post">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.10 0.10 1.00</size></box></geometry>
        </collision>
        <visual name="vis_post">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.10 0.10 1.00</size></box></geometry>
          <material>
            <ambient>0.30 0.18 0.08 1</ambient>
            <diffuse>0.50 0.30 0.14 1</diffuse>
          </material>
        </visual>
        <!-- Mailbox body (rectangular box, dark blue) -->
        <visual name="vis_body">
          <pose>0 0 1.18 0 0 0</pose>
          <geometry><box><size>0.50 0.22 0.22</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.30 1</ambient>
            <diffuse>0.10 0.20 0.55 1</diffuse>
            <specular>0.10 0.10 0.20 1</specular>
          </material>
        </visual>
        <!-- Curved top (cylinder lying on its side) -->
        <visual name="vis_top">
          <pose>0 0 1.30 1.5708 0 1.5708</pose>
          <geometry><cylinder><radius>0.11</radius><length>0.50</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.10 0.30 1</ambient>
            <diffuse>0.10 0.20 0.55 1</diffuse>
            <specular>0.10 0.10 0.20 1</specular>
          </material>
        </visual>
        <!-- Red flag (folded down) -->
        <visual name="vis_flag">
          <pose>0.27 -0.05 1.20 0 0 0</pose>
          <geometry><box><size>0.02 0.06 0.18</size></box></geometry>
          <material>
            <ambient>0.50 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         DISTRACTING OBJECTS — DRONE SIDE  (x > 3)
         ════════════════════════════════════════════════════════════════ -->

    <!-- Construction cone — drone side north -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_drone_n</name>
      <pose>5.0 3.0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Construction cone — drone side south -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_drone_s</name>
      <pose>4.5 -3.5 0 0 0 1.2</pose>
      <static>true</static>
    </include>

    <!-- Steel drum — drone side north -->
    <model name="barrel_drone_n">
      <static>true</static>
      <pose>6.0 2.0 0.44 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.28</radius><length>0.88</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.28</radius><length>0.88</length></cylinder></geometry>
          <material>
            <ambient>0.28 0.18 0.08 1</ambient>
            <diffuse>0.40 0.28 0.12 1</diffuse>
            <specular>0.20 0.15 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Stacked crates — drone side south -->
    <model name="crate_drone_lo">
      <static>true</static>
      <pose>5.8 -2.5 0.30 0 0 0.5</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.60 0.60 0.60</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.60 0.60 0.60</size></box></geometry>
          <material>
            <ambient>0.42 0.28 0.14 1</ambient>
            <diffuse>0.52 0.36 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="crate_drone_hi">
      <static>true</static>
      <pose>5.8 -2.5 0.75 0 0 0.9</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.40 0.40 0.40</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.40 0.40 0.40</size></box></geometry>
          <material>
            <ambient>0.42 0.28 0.14 1</ambient>
            <diffuse>0.52 0.36 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         DRONE: x3  (kinematic — position set via gz service set_pose)
         Starts on drone side (x=5, y=0), facing -X (pi radians).
         gravity=false so it floats; mission_node teleports it each cycle.
         ════════════════════════════════════════════════════════════════ -->
    <model name="x3">
      <pose>5 0 0.11 0 0 3.14159</pose>

      <!-- ── Base link ─────────────────────────────────────────────── -->
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.5</mass>
          <inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz></inertia>
        </inertial>

        <!-- ── Body: central hub ──────────────────────────────────── -->
        <visual name="body_top">
          <pose>0 0 0.015 0 0 0</pose>
          <geometry><box><size>0.11 0.11 0.025</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <visual name="body_bottom">
          <pose>0 0 -0.010 0 0 0</pose>
          <geometry><box><size>0.09 0.09 0.018</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>

        <!-- ── Arms ──────────────────────────────────────────────── -->
        <visual name="arm_x">
          <pose>0 0 -0.002 0 0 0</pose>
          <geometry><box><size>0.46 0.028 0.016</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="arm_y">
          <pose>0 0 -0.002 0 0 0</pose>
          <geometry><box><size>0.028 0.46 0.016</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material>
        </visual>

        <!-- ── Motor housings ─────────────────────────────────────── -->
        <visual name="motor_px">
          <pose>0.23 0 0.005 0 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.030</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material>
        </visual>
        <visual name="motor_nx">
          <pose>-0.23 0 0.005 0 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.030</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material>
        </visual>
        <visual name="motor_py">
          <pose>0 0.23 0.005 0 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.030</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material>
        </visual>
        <visual name="motor_ny">
          <pose>0 -0.23 0.005 0 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.030</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material>
        </visual>

        <!-- ── Propellers (white = ±X, dark = ±Y) ───────────────── -->
        <visual name="prop_px">
          <pose>0.23 0 0.026 0 0 0</pose>
          <geometry><cylinder><radius>0.105</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
        <visual name="prop_nx">
          <pose>-0.23 0 0.026 0 0 0</pose>
          <geometry><cylinder><radius>0.105</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
        <visual name="prop_py">
          <pose>0 0.23 0.026 0 0 0</pose>
          <geometry><cylinder><radius>0.105</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse></material>
        </visual>
        <visual name="prop_ny">
          <pose>0 -0.23 0.026 0 0 0</pose>
          <geometry><cylinder><radius>0.105</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse></material>
        </visual>

        <!-- ── Landing gear ───────────────────────────────────────── -->
        <visual name="leg_fl">
          <pose>0.13 0.10 -0.045 0 0 0</pose>
          <geometry><cylinder><radius>0.007</radius><length>0.065</length></cylinder></geometry>
          <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
        </visual>
        <visual name="leg_fr">
          <pose>0.13 -0.10 -0.045 0 0 0</pose>
          <geometry><cylinder><radius>0.007</radius><length>0.065</length></cylinder></geometry>
          <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
        </visual>
        <visual name="leg_bl">
          <pose>-0.13 0.10 -0.045 0 0 0</pose>
          <geometry><cylinder><radius>0.007</radius><length>0.065</length></cylinder></geometry>
          <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
        </visual>
        <visual name="leg_br">
          <pose>-0.13 -0.10 -0.045 0 0 0</pose>
          <geometry><cylinder><radius>0.007</radius><length>0.065</length></cylinder></geometry>
          <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
        </visual>
        <visual name="skid_left">
          <pose>0 0.10 -0.073 0 0 0</pose>
          <geometry><box><size>0.28 0.012 0.010</size></box></geometry>
          <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
        </visual>
        <visual name="skid_right">
          <pose>0 -0.10 -0.073 0 0 0</pose>
          <geometry><box><size>0.28 0.012 0.010</size></box></geometry>
          <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
        </visual>

        <!-- ── Camera gimbal (orange = front direction marker) ────── -->
        <visual name="cam_gimbal">
          <pose>0.10 0 -0.018 0 0.5236 0</pose>
          <geometry><box><size>0.035 0.030 0.025</size></box></geometry>
          <material>
            <ambient>0.8 0.35 0.0 1</ambient>
            <diffuse>1.0 0.45 0.0 1</diffuse>
          </material>
        </visual>

        <!-- ── LiDAR dome (blue) ──────────────────────────────────── -->
        <visual name="lidar_housing">
          <pose>0 0 0.038 0 0 0</pose>
          <geometry><cylinder><radius>0.030</radius><length>0.020</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.05 0.35 1</ambient>
            <diffuse>0.08 0.08 0.55 1</diffuse>
          </material>
        </visual>

        <!-- ── RGB Camera (name/pose FIXED) ──────────────────────── -->
        <!-- Camera mounted UNDER the drone body (z=-0.05) so the drone's
             own front motor / arm / propeller never enter the camera's
             upper-frame FOV. At z=+0.02 (the original mount), the front
             motor housing projected to v≈[0..170] of the 720-pixel frame
             — a persistent dark trapezoid in every captured image that
             polluted both reconstruction inputs and SAM3 mask edges.
             The 0.07 m vertical offset between drone center and camera
             is small relative to depth-camera ray-cast noise (~0.5 m)
             and we ignore it in mission_node ray geometry. -->
        <sensor name="camera" type="camera">
          <pose>0.1 0 -0.05 0 0.5236 0</pose>
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image><width>1280</width><height>720</height><format>RGB_INT8</format></image>
            <clip><near>0.05</near><far>100</far></clip>
          </camera>
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
        </sensor>

        <!-- ── Depth camera (matches RGB pose) ────────────────────── -->
        <sensor name="depth_camera" type="depth_camera">
          <pose>0.1 0 -0.05 0 0.5236 0</pose>
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
            <clip><near>0.05</near><far>20</far></clip>
          </camera>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
        </sensor>

        <!-- ── 16-channel LiDAR ───────────────────────────────────── -->
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.05 0 0 0</pose>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples><resolution>1</resolution>
                <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples><resolution>1</resolution>
                <min_angle>-0.2618</min_angle><max_angle>0.2618</max_angle>
              </vertical>
            </scan>
            <range><min>0.10</min><max>30.0</max><resolution>0.01</resolution></range>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
          </lidar>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
        </sensor>

        <!-- ── IMU ────────────────────────────────────────────────── -->
        <sensor name="imu" type="imu">
          <update_rate>100</update_rate>
          <always_on>true</always_on>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>

      </link>

      <!-- ── Pose publisher ────────────────────────────────────────── -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>true</publish_link_pose>
        <update_frequency>20</update_frequency>
      </plugin>

      <!-- ── Velocity controller (Tier 1 of the flight-controller plan) ──
           Subscribes to /model/x3/cmd_vel (gz.msgs.Twist) and applies the
           commanded linear+angular velocity directly to the model link.
           Harmless when not in use: if no Twist is published, the drone
           sits still (and gravity is off, so it doesn't fall).
           mission_node only publishes here when control_mode is set to
           'velocity_kinematic' — by default it still uses set_pose. ─── -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
      </plugin>

    </model>

  </world>
</sdf>
